{
  "id": "chat-from-top",
  "type": "module",
  "title": "Chat do Topo",
  "description": "Inverte o fluxo do chat: a mensagem mais recente aparece no topo e as antigas descem conforme novas chegam.",
  "version": "1.2.0",
  "compatibility": { "minimum": "13", "maximum": "14", "verified": "14.364" },
  "authors": [{ "name": "Luan" }],
  "url": "https://github.com/Lorian2/chat-from-top",
  "manifest": "https://github.com/Lorian2/chat-from-top/releases/latest/download/module.json",
  "download": "https://github.com/Lorian2/chat-from-top/releases/latest/download/chat-from-top.zip",
  "readme": "https://github.com/Lorian2/chat-from-top/blob/main/README.md",
  "changelog": "https://github.com/Lorian2/chat-from-top/blob/main/CHANGELOG.md",
  "bugs": "https://github.com/Lorian2/chat-from-top/issues",
  "license": "LICENSE",
  "esmodules": ["scripts/main.mjs"],
  "styles": ["styles/chat-from-top.css", "styles/sidebar-right.css"],
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json" },
    { "lang": "pt-BR", "name": "Português (Brasil)", "path": "lang/pt-BR.json" }
  ],
  "flags": {
    "hotReload": { "extensions": ["css", "json"], "paths": ["styles", "lang"] }
  }
}
